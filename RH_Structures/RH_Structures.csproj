<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>RH_Structures</RootNamespace>
    <AssemblyName>RH_Structures</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- RhinoCommon 8 ships a net48 build only; net7.0 consumes it via fallback. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rhino supplies RhinoCommon, Eto and Rhino.UI at runtime, so they must not be copied to the output. -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Structures\Structures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Panel icon, loaded by resource name in RHStructuresPlugIn.OnLoad. -->
    <EmbeddedResource Include="Resources\Relax.png" LogicalName="RH_Structures.Resources.Relax.png" />
  </ItemGroup>

  <!-- Rhino for Mac installs a RhinoCommon plug-in from a .macrhi file: a zip holding a folder
       named X.rhp, which in turn holds X.rhp and its dependencies (like Rhino's own
       ManagedPlugIns). Build bin/<Configuration>/RH_Structures.macrhi; open it to install. -->
  <Target Name="MacPlugInInstaller" AfterTargets="Build">
    <PropertyGroup>
      <MacStagingDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/macrhi</MacStagingDir>
      <MacBundleDir>$(MacStagingDir)/$(AssemblyName).rhp</MacBundleDir>
      <MacInstaller>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(AssemblyName).macrhi</MacInstaller>
    </PropertyGroup>
    <ItemGroup>
      <MacBundleFiles Include="$(OutDir)*.rhp;$(OutDir)*.dll;$(OutDir)*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(MacStagingDir)" />
    <Copy SourceFiles="@(MacBundleFiles)" DestinationFolder="$(MacBundleDir)" />
    <ZipDirectory SourceDirectory="$(MacStagingDir)" DestinationFile="$(MacInstaller)" Overwrite="true" />
    <Message Importance="high" Text="Rhino for Mac installer: $(MacInstaller)" />
  </Target>

</Project>
